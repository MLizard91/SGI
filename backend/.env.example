# Puerto donde corre la API
PORT=4000

# Conexión a SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SGI_Mexticacan
DB_USER=sa
DB_PASSWORD=TuPasswordSeguro
# Pon "true" si usas Azure SQL o un certificado válido; para SQL Server local con certificado autofirmado deja "false"
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Clave para firmar los tokens de sesión (cámbiala por una cadena larga y aleatoria)
JWT_SECRET=cambia-esta-clave-por-una-muy-larga-y-secreta
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS separados por coma (panel web). Usa * en desarrollo.
CORS_ORIGIN=*

# Tamaño máximo por imagen en MB
MAX_IMAGE_MB=8
